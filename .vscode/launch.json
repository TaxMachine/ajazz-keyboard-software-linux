{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ak820proLED (Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/ak820proLED",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Habilitar pretty-printing para gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: Build"
    },
    {
      "name": "ak820proLED (Attach)",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/build/ak820proLED",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Habilitar pretty-printing para gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Python: hidfilter.py (Analyze)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analyze/hidfilter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/analyze"
    }
  ]
}
